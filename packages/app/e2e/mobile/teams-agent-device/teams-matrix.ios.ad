context platform=ios timeout=600000 retries=1
env APP_ID=sh.paseo.debug

open "${APP_ID}"
settings clear-app-state "${APP_ID}"
open "${APP_ID}" --relaunch --metro-host "${METRO_HOST}" --metro-port "${METRO_PORT}" --launch-url "${DEV_CLIENT_URL}"
alert wait 45000
alert dismiss
settings appearance light
wait "id=\"menu-button\"" 45000

press "id=\"menu-button\""
wait "id=\"sidebar-teams\"" 10000
press "id=\"sidebar-teams\""
wait "id=\"teams-list\"" 30000
wait "id=\"teams-host-${PRIMARY_SERVER_ID}\"" 30000
wait "id=\"team-row-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\"" 30000
screenshot "${AD_ARTIFACTS}/teams-list-light.png" --scale 1

press "id=\"team-row-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\""
wait "id=\"team-detail-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\"" 30000
scroll down 0.6
wait "id=\"team-role-${PRIMARY_SERVER_ID}%3A${PRIMARY_TEAM_ID}-${PRIMARY_TEAM_ROLE_ID}\"" 30000
scroll down 0.6
wait "id=\"team-step-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}-${PRIMARY_TEAM_STEP_ID}\"" 30000
screenshot "${AD_ARTIFACTS}/teams-detail-large-text.png" --scale 1

orientation landscape-left
wait "id=\"team-detail-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\"" 10000
screenshot "${AD_ARTIFACTS}/teams-detail-landscape.png" --scale 1
orientation portrait
wait "id=\"team-detail-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\"" 10000

home
open "${APP_ID}"
wait "id=\"team-detail-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\"" 30000
scroll top
press "id=\"team-run-open-${PRIMARY_SERVER_ID}-${PRIMARY_TEAM_ID}\""
wait "id=\"team-run-form-sheet\"" 30000
press "id=\"team-run-workspace-field\""
wait "id=\"team-run-workspace-${PRIMARY_WORKSPACE_ID}\"" 30000
press "id=\"team-run-workspace-${PRIMARY_WORKSPACE_ID}\""
fill "id=\"team-run-objective\"" "Verify the native Team permission boundary."
keyboard dismiss
scroll down 0.6
wait "id=\"team-run-role-status-${PRIMARY_TEAM_ROLE_ID}-ready\"" 30000
press "id=\"team-run-start\""
wait "id=\"team-run-status-waiting_for_permission\"" 30000
screenshot "${AD_ARTIFACTS}/teams-waiting-for-permission.png" --scale 1
scroll down 0.8
scroll down 0.8
wait "id=\"team-run-step-status-${PRIMARY_TEAM_STEP_ID}-waiting_for_permission\"" 10000
screenshot "${AD_ARTIFACTS}/teams-waiting-step.png" --scale 1

press "id=\"team-run-step-agent-${PRIMARY_TEAM_STEP_ID}\""
wait "id=\"permission-request-question\"" 30000
screenshot "${AD_ARTIFACTS}/teams-permission.png" --scale 1
press "id=\"permission-request-accept\""
back
scroll top
wait "id=\"team-run-status-succeeded\"" 30000
scroll down 0.8
scroll down 0.8
wait "id=\"team-run-step-status-${PRIMARY_TEAM_STEP_ID}-succeeded\"" 10000
screenshot "${AD_ARTIFACTS}/teams-succeeded.png" --scale 1
close
